+func TestAPIManagementLabels(t *testing.T) {
+	tests := []struct {
+		desc           string
+		cfg            *aimetrics.Metrics
+		headers        map[string]string
+		expectedLabels map[string]string
+		absentKeys     []string
+	}{
+		{
+			desc:       "no metrics config emits no labels",
+			cfg:        nil,
+			headers:    map[string]string{middleware.HubAppIDHeader: "app-id", middleware.HubAppNameHeader: "app-name", middleware.HubUserIDHeader: "user-id"},
+			absentKeys: []string{"app_id", "app_name", "user_id"},
+		},
+		{
+			desc:       "all flags disabled emits no labels",
+			cfg:        &aimetrics.Metrics{},
+			headers:    map[string]string{middleware.HubAppIDHeader: "app-id", middleware.HubAppNameHeader: "app-name", middleware.HubUserIDHeader: "user-id"},
+			absentKeys: []string{"app_id", "app_name", "user_id"},
+		},
+		{
+			desc:           "appId flag alone emits only app_id",
+			cfg:            &aimetrics.Metrics{AddLabels: aimetrics.AddLabels{AppID: true}},
+			headers:        map[string]string{middleware.HubAppIDHeader: "app-id", middleware.HubAppNameHeader: "app-name", middleware.HubUserIDHeader: "user-id"},
+			expectedLabels: map[string]string{"app_id": "app-id"},
+			absentKeys:     []string{"app_name", "user_id"},
+		},
+		{
+			desc:           "appName flag alone emits only app_name",
+			cfg:            &aimetrics.Metrics{AddLabels: aimetrics.AddLabels{AppName: true}},
+			headers:        map[string]string{middleware.HubAppIDHeader: "app-id", middleware.HubAppNameHeader: "app-name", middleware.HubUserIDHeader: "user-id"},
+			expectedLabels: map[string]string{"app_name": "app-name"},
+			absentKeys:     []string{"app_id", "user_id"},
+		},
+		{
+			desc:           "userId flag alone emits only user_id",
+			cfg:            &aimetrics.Metrics{AddLabels: aimetrics.AddLabels{UserID: true}},
+			headers:        map[string]string{middleware.HubAppIDHeader: "app-id", middleware.HubAppNameHeader: "app-name", middleware.HubUserIDHeader: "user-id"},
+			expectedLabels: map[string]string{"user_id": "user-id"},
+			absentKeys:     []string{"app_id", "app_name"},
+		},
+		{
+			desc: "flags enabled but headers empty emit no labels",
+			cfg: &aimetrics.Metrics{AddLabels: aimetrics.AddLabels{
+				AppID:   true,
+				AppName: true,
+				UserID:  true,
+			}},
+			headers:    map[string]string{},
+			absentKeys: []string{"app_id", "app_name", "user_id"},
+		},
+	}
+
+	// Sub-tests cannot run in parallel: metrics.SetMeterProvider sets a global.
+	for _, test := range tests {
+		t.Run(test.desc, func(t *testing.T) {
+			rdr := sdkmetric.NewManualReader()
+			meterProvider := sdkmetric.NewMeterProvider(sdkmetric.WithReader(rdr))
+			metrics.SetMeterProvider(meterProvider)
+
+			var otlpCfg ottypes.OTLP
+			(&otlpCfg).SetDefaults()
+			otlpCfg.AddRoutersLabels = true
+			otlpCfg.PushInterval = ptypes.Duration(10 * time.Millisecond)
+
+			semConvMetricRegistry, err := metrics.NewSemConvMetricRegistry(t.Context(), &otlpCfg)
+			require.NoError(t, err)
+
+			mCfg := Config{
+				APIKey:  "test-api-key",
+				Model:   "claude-opus-4-5",
+				Metrics: test.cfg,
+			}
+
+			tp := observability.NewObservabilityRoundTripper(mockTransport{response: &http.Response{
+				StatusCode: http.StatusOK,
+				Body:       io.NopCloser(strings.NewReader(`{"id":"msg_1","type":"message","role":"assistant","model":"claude-opus-4-5-20251101","content":[],"usage":{"input_tokens":1,"output_tokens":1}}`)),
+			}})
+
+			proxy := &httputil.ReverseProxy{Transport: tp, Director: func(*http.Request) {}}
+
+			h, err := New(proxy, mCfg, "test", semConvMetricRegistry, []float64{}, &static.AIGateway{MaxRequestBodySize: 1024 * 1024})
+			require.NoError(t, err)
+
+			body := `{"model":"claude-opus-4-5","messages":[{"role":"user","content":"hi"}],"max_tokens":16}`
+			req := httptest.NewRequest(http.MethodPost, "https://api.anthropic.com/v1/messages", bytes.NewBufferString(body))
+			req.ContentLength = int64(len(body))
+			for k, v := range test.headers {
+				req.Header.Set(k, v)
+			}
+
+			ctx := tobservability.WithObservability(req.Context(), tobservability.Observability{
+				MetricsEnabled:        true,
+				SemConvMetricsEnabled: true,
+			})
+			req = req.WithContext(ctx)
+
+			h.ServeHTTP(httptest.NewRecorder(), req)
+
+			got := metricdata.ResourceMetrics{}
+			require.NoError(t, rdr.Collect(t.Context(), &got))
+			require.Len(t, got.ScopeMetrics, 1)
+			require.GreaterOrEqual(t, len(got.ScopeMetrics[0].Metrics), 1)
+
+			for _, m := range got.ScopeMetrics[0].Metrics {
+				aimetricstest.AssertAttributePresence(t, m, test.expectedLabels, test.absentKeys)
+			}
+		})
+	}
+}
