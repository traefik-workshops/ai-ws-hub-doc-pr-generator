@@ -0,0 +1,57 @@
+// Package aimetrics provides the opt-in API Management label configuration
+// shared by the AI middlewares (chat-completion, responses-api, messages-api).
+package aimetrics
+
+import (
+	"net/http"
+
+	"github.com/traefik/traefik-hub/v3/hub/pkg/middleware"
+	"go.opentelemetry.io/otel/attribute"
+)
+
+// +k8s:deepcopy-gen=true
+
+// Metrics holds the opt-in configuration that controls which API Management
+// labels are added to the gen_ai metrics emitted by the AI middlewares.
+type Metrics struct {
+	AddLabels AddLabels `json:"addLabels,omitzero"`
+}
+
+// +k8s:deepcopy-gen=true
+
+// AddLabels selects which API Management attributes are appended to gen_ai
+// metrics. Each flag is independent and defaults to false.
+type AddLabels struct {
+	AppID   bool `json:"appId,omitempty"`
+	AppName bool `json:"appName,omitempty"`
+	UserID  bool `json:"userId,omitempty"`
+}
+
+// AppendAPIManagementAttrs appends the enabled API Management attributes to
+// attrs based on cfg and the Hub-* headers present on req. It returns attrs
+// unchanged when cfg is nil, and skips any flag whose source header is empty.
+func AppendAPIManagementAttrs(req *http.Request, cfg *Metrics, attrs []attribute.KeyValue) []attribute.KeyValue {
+	if cfg == nil {
+		return attrs
+	}
+
+	if cfg.AddLabels.AppID {
+		if v := req.Header.Get(middleware.HubAppIDHeader); v != "" {
+			attrs = append(attrs, attribute.String("app_id", v))
+		}
+	}
+
+	if cfg.AddLabels.AppName {
+		if v := req.Header.Get(middleware.HubAppNameHeader); v != "" {
+			attrs = append(attrs, attribute.String("app_name", v))
+		}
+	}
+
+	if cfg.AddLabels.UserID {
+		if v := req.Header.Get(middleware.HubUserIDHeader); v != "" {
+			attrs = append(attrs, attribute.String("user_id", v))
+		}
+	}
+
+	return attrs
+}
diff --git a/hub/pkg/middleware/aimetrics/labels_test.go b/hub/pkg/middleware/aimetrics/labels_test.go
new file mode 100644
index 0000000000..675526b2e1
