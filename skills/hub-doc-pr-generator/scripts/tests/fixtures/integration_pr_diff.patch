@@ -0,0 +1,97 @@
+package aimetrics
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/traefik/traefik-hub/v3/hub/pkg/middleware"
+	"go.opentelemetry.io/otel/attribute"
+)
+
+func TestAppendAPIManagementAttrs(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		desc     string
+		cfg      *Metrics
+		headers  map[string]string
+		expected []attribute.KeyValue
+	}{
+		{
+			desc: "nil config returns attrs unchanged",
+			cfg:  nil,
+			headers: map[string]string{
+				middleware.HubAppIDHeader:   "app-id",
+				middleware.HubAppNameHeader: "app-name",
+				middleware.HubUserIDHeader:  "user-id",
+			},
+			expected: nil,
+		},
+		{
+			desc:     "all flags disabled returns attrs unchanged",
+			cfg:      &Metrics{},
+			headers:  map[string]string{middleware.HubAppIDHeader: "app-id"},
+			expected: nil,
+		},
+		{
+			desc: "all flags enabled with headers set",
+			cfg: &Metrics{AddLabels: AddLabels{
+				AppID:   true,
+				AppName: true,
+				UserID:  true,
+			}},
+			headers: map[string]string{
+				middleware.HubAppIDHeader:   "app-id",
+				middleware.HubAppNameHeader: "app-name",
+				middleware.HubUserIDHeader:  "user-id",
+			},
+			expected: []attribute.KeyValue{
+				attribute.String("app_id", "app-id"),
+				attribute.String("app_name", "app-name"),
+				attribute.String("user_id", "user-id"),
+			},
+		},
+		{
+			desc: "only userId flag enabled",
+			cfg:  &Metrics{AddLabels: AddLabels{UserID: true}},
+			headers: map[string]string{
+				middleware.HubAppIDHeader:   "app-id",
+				middleware.HubAppNameHeader: "app-name",
+				middleware.HubUserIDHeader:  "user-id",
+			},
+			expected: []attribute.KeyValue{
+				attribute.String("user_id", "user-id"),
+			},
+		},
+		{
+			desc: "flag enabled but header empty skips label",
+			cfg: &Metrics{AddLabels: AddLabels{
+				AppID:   true,
+				AppName: true,
+				UserID:  true,
+			}},
+			headers: map[string]string{
+				middleware.HubAppIDHeader: "app-id",
+			},
+			expected: []attribute.KeyValue{
+				attribute.String("app_id", "app-id"),
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			req := httptest.NewRequest(http.MethodPost, "http://example.com", http.NoBody)
+			for k, v := range test.headers {
+				req.Header.Set(k, v)
+			}
+
+			got := AppendAPIManagementAttrs(req, test.cfg, nil)
+			assert.Equal(t, test.expected, got)
+		})
+	}
+}
