index 0000000000..87e6a8ef71
--- /dev/null
+++ b/hub/pkg/testutil/aimetrics/assert.go
@@ -0,0 +1,62 @@
+// Package aimetrics provides test helpers for asserting on the gen_ai metric
+// attributes emitted by the AI middlewares (chat-completion, responses-api,
+// messages-api).
+package aimetrics
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/otel/attribute"
+	"go.opentelemetry.io/otel/sdk/metric/metricdata"
+)
+
+// AssertAttributePresence verifies that the metric's data point attribute sets
+// contain every expected key/value pair and none of the absent keys.
+func AssertAttributePresence(t *testing.T, m metricdata.Metrics, expected map[string]string, absent []string) {
+	t.Helper()
+
+	var attrSets []attribute.Set
+	switch d := m.Data.(type) {
+	case metricdata.Histogram[float64]:
+		for _, dp := range d.DataPoints {
+			attrSets = append(attrSets, dp.Attributes)
+		}
+	case metricdata.Histogram[int64]:
+		for _, dp := range d.DataPoints {
+			attrSets = append(attrSets, dp.Attributes)
+		}
+	case metricdata.Sum[float64]:
+		for _, dp := range d.DataPoints {
+			attrSets = append(attrSets, dp.Attributes)
+		}
+	case metricdata.Sum[int64]:
+		for _, dp := range d.DataPoints {
+			attrSets = append(attrSets, dp.Attributes)
+		}
+	case metricdata.Gauge[float64]:
+		for _, dp := range d.DataPoints {
+			attrSets = append(attrSets, dp.Attributes)
+		}
+	case metricdata.Gauge[int64]:
+		for _, dp := range d.DataPoints {
+			attrSets = append(attrSets, dp.Attributes)
+		}
+	}
+
+	require.NotEmpty(t, attrSets, "metric %q has no data points", m.Name)
+
+	for _, attrs := range attrSets {
+		for key, want := range expected {
+			got, ok := attrs.Value(attribute.Key(key))
+			assert.True(t, ok, "metric %q: expected attribute %q not found", m.Name, key)
+			assert.Equal(t, want, got.AsString(), "metric %q: attribute %q mismatch", m.Name, key)
+		}
+
+		for _, key := range absent {
+			_, ok := attrs.Value(attribute.Key(key))
+			assert.False(t, ok, "metric %q: attribute %q must not be present", m.Name, key)
+		}
+	}
+}
